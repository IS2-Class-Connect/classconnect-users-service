// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uuid String @id 
  email    String @unique
  name     String
  urlProfilePhoto String
  provider String
  latitude        Float?
  longitude       Float?
  failedAttempts   Int       @default(0)
  lastFailedAt     DateTime? 
  lockUntil        DateTime? 
  accountLocked  Boolean   @default(false)
  accountLockedByAdmins  Boolean   @default(false)
  description String @default("")
  createdAt DateTime @default(now())
  lastSession DateTime @default(now())
  pushToken String?

  // push notifications configuration
  pushTaskAssignment    Boolean @default(true)
  pushMessageReceived   Boolean @default(true)
  pushDeadlineReminder  Boolean @default(true)

  // email notifications configuration
  emailEnrollment          Boolean @default(true)
  emailAssistantAssignment Boolean @default(true)
}

model UnknownQuestions {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  question  String
}

model Feedback {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  answer          String
  comment_feedback String
  rating           Int
  userId           String
}
